export LANG="${LANG:-zh_CN.UTF-8}"
export LC_ALL="${LC_CTYPE:-zh_CN.UTF-8}"

source ~/.dotfiles/.env

# ── Zsh 启动缓存优化 ──────────────────────────────────────────────
# 缓存 glob 结果，避免每次启动都遍历文件系统
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$ZSH_CACHE_DIR"

ZSH_SOURCES_CACHE="$ZSH_CACHE_DIR/sources.zsh"
ZSHRC_MTIME=$(stat -c %Y ~/.dotfiles/zsh/zshrc 2>/dev/null || stat -f %m ~/.dotfiles/zsh/zshrc 2>/dev/null)

# 如果缓存不存在或 zshrc 比缓存新，则重新生成
if [[ ! -f "$ZSH_SOURCES_CACHE" || ! -f "$ZSH_CACHE_DIR/zshrc.zwc" || "$ZSHRC_MTIME" -gt $(stat -c %Y "$ZSH_SOURCES_CACHE" 2>/dev/null || stat -f %m "$ZSH_SOURCES_CACHE" 2>/dev/null || echo 0) ]]; then
  : >| "$ZSH_SOURCES_CACHE"
  for file in ~/.dotfiles/zsh/*.sh(N); do
    [[ -f "$file" ]] && echo "source '$file'" >> "$ZSH_SOURCES_CACHE"
  done
fi

source "$ZSH_SOURCES_CACHE"

# 预编译 zshrc 和 alias.zsh 加速加载
[[ ~/.dotfiles/zsh/zshrc -nt "$ZSH_CACHE_DIR/zshrc.zwc" ]] && zcompile -R "$ZSH_CACHE_DIR/zshrc.zwc" ~/.dotfiles/zsh/zshrc 2>/dev/null
[[ ~/.dotfiles/zsh/alias.zsh -nt "$ZSH_CACHE_DIR/alias.zwc" ]] && zcompile -R "$ZSH_CACHE_DIR/alias.zwc" ~/.dotfiles/zsh/alias.zsh 2>/dev/null

# ZSH config
bindkey '^n' end-of-line

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh
DISABLE_AUTO_UPDATE='true'
ZSH_DISABLE_COMPFIX='true'
ZSH_THEME='hjkl01'

plugins=(
  zsh-autosuggestions
  zsh-you-should-use
  zsh-syntax-highlighting
)
source $HOME/.oh-my-zsh/oh-my-zsh.sh

source $HOME/.dotfiles/zsh/alias.zsh

setopt NO_HUP

# tmux.conf handles TERM setting; only set for non-tmux sessions
[ -z "$TMUX" ] && export TERM="xterm-256color"

alias run_tmux='tmux -f ~/.dotfiles/config/tmux.conf -u'
if [[ "${START_TMUX:-0}" == "1" && -z "$TMUX" ]]; then
  if tmux has-session 2>/dev/null; then
    tmux attach
  else
    run_tmux
  fi
fi

alias run_zellij='zellij attach main || zellij -s main'
if [[ "${START_ZELLIJ:-0}" == "1" && -z "$ZELLIJ" ]] && command -v zellij &>/dev/null; then
  zellij attach main || zellij -s main
fi
