export LANG="${LANG:-zh_CN.UTF-8}"
export LC_ALL="${LC_CTYPE:-zh_CN.UTF-8}"

source ~/.dotfiles/.env

# 直接加载配置片段，避免启动时通过 stat、命令替换和缓存生成创建额外子进程。
# Zsh 的 (N) glob qualifier 在目录无匹配文件时返回空列表。
for file in ~/.dotfiles/zsh/*.sh(N); do
  [[ -f "$file" ]] && source "$file"
done

# ZSH config
bindkey '^n' end-of-line

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh
DISABLE_AUTO_UPDATE='true'
ZSH_DISABLE_COMPFIX='true'
ZSH_THEME='hjkl01'

plugins=(
  zsh-autosuggestions
  zsh-you-should-use
  zsh-syntax-highlighting
)
source $HOME/.oh-my-zsh/oh-my-zsh.sh

source $HOME/.dotfiles/zsh/alias.zsh

setopt NO_HUP

# tmux.conf handles TERM setting; only set for non-tmux sessions
[ -z "$TMUX" ] && export TERM="xterm-256color"

alias run_tmux='tmux -f ~/.dotfiles/config/tmux.conf -u'
if [[ "${START_TMUX:-0}" == "1" && -z "$TMUX" ]]; then
  if tmux has-session 2>/dev/null; then
    tmux attach
  else
    run_tmux
  fi
fi

# zellij: tab 名跟随当前目录（等价 tmux 的 automatic-rename + pane_current_path）
# 注：rename-tab 只能改「当前聚焦的 tab」，后台 shell 跑完命令重命名可能落到别的 tab；
# 缓存同名目录时新 tab 首次不会刷新（下一个不同目录生效）
if [[ -n "$ZELLIJ" ]]; then
  autoload -Uz add-zsh-hook
  _zellij_tab_cwd() {
    local name=${PWD:t}
    [[ -n "$name" && "$name" != "$_zellij_tab_last" ]] || return
    _zellij_tab_last=$name
    zellij action rename-tab "$name" 2>/dev/null
  }
  add-zsh-hook precmd _zellij_tab_cwd
fi

# 优先进入已有的 Zellij 会话；没有会话时创建 main。
# --short 只输出会话名，避免解析普通列表中的状态信息。
run_zellij() {
  command -v zellij >/dev/null 2>&1 || {
    echo "错误：未找到 zellij" >&2
    return 127
  }

  if [[ -n "$ZELLIJ" ]]; then
    echo "当前已在 Zellij 会话中。" >&2
    return 0
  fi

  local session
  session=$(zellij list-sessions --short 2>/dev/null | head -n 1)

  if [[ -n "$session" ]]; then
    zellij attach "$session"
  else
    zellij -s main
  fi
}

if [[ "${START_ZELLIJ:-0}" == "1" && -z "$ZELLIJ" ]] && command -v zellij >/dev/null 2>&1; then
  run_zellij
fi
